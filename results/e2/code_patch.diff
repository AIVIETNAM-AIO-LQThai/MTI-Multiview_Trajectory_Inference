@@ -73,6 +73,15 @@ def sample_family(family: str, B: int, L: int, gen: torch.Generator):
         beta = 0.5 * torch.rand(B, 1, generator=gen)
         e = -torch.log(torch.rand(B, L, generator=gen).clamp_min(1e-12))   # Exp(1) -> normalised = Dirichlet(1)
